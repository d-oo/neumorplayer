# --- 클라이언트에 노출되어도 되는 값 (Vite가 번들에 그대로 심음) ---
# Project Settings → Data API에서 Project URL을,
# Project Settings → API Keys에서 Publishable key(sb_publishable_...)를 확인하세요.
# publishable key는 공개되어도 안전합니다. 실제 접근 제어는 DB의 RLS 정책이 담당합니다.
# (예전 이름: anon key. secret key(예전 service_role key)는 여기 넣지 마세요 — RLS를 우회합니다.)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- 서버 전용 값 (절대 VITE_ 접두사를 붙이지 마세요) ---
# /api 아래 Vercel 서버리스 함수에서만 process.env로 읽습니다. 브라우저 번들에는 절대 포함되지 않습니다.
YOUTUBE_API_KEY=your-new-youtube-data-api-key
